# Puerto del API (en producción también sirve el frontend compilado)
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Ruta del archivo SQLite (relativa a server/). En Railway/Fly apunta al volumen: /data/bibliaquiz.db
DB_PATH=./data/bibliaquiz.db

# Duración de la sesión en días
SESSION_DAYS=30

# Carpeta con el build del frontend (web/dist). Se sirve solo si existe.
WEB_DIST=../web/dist
